# ============================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.
# ============================================================

# ---------- Backend ----------
# Comma-separated key pool (at least 2). Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-gemini-key-1,your-gemini-key-2

# LiteLLM model name (provider/model)
LLM_MODEL=gemini/gemini-3.5-flash-lite

# SQLite location. Four slashes = absolute path (/data/app.db inside Docker).
DATABASE_URL=sqlite:////data/app.db

# Comma-separated CORS origins allowed to call the backend
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# true = honour the X-Simulate-Failure header on POST /chat
ENABLE_FAILURE_SIMULATION=true

# Used when the client does not send a system_prompt
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.

# Seconds to wait for one provider call before treating it as failed
LLM_TIMEOUT_SECONDS=30

# ---------- Frontend (build time) ----------
# Base URL of the backend the React app talks to
VITE_API_BASE_URL=http://localhost:8000
